# infra/resm.env 로 복사해 채운다. infra/resm.env 는 git 에 올리지 않는다(.gitignore 의 .env.* 규칙).
# 비밀번호는 기존 스택의 real-es/infra/secrets/app.env 의 DATABASE_URL 과 같은 값을 쓴다.
# 비밀번호에 특수문자가 있으면 URL 인코딩된 상태 그대로 옮긴다.
DATABASE_URL=postgresql://real_es_app:REPLACE_URL_ENCODED@postgres:5432/real_es
RESM_BIND=0.0.0.0:3104
RESM_COOKIE_SECURE=true
# 앱(Windows 설치본·Android) WebView 의 Origin. 브라우저(resm2.approid.team)는 same-origin 이라 넣지 않는다.
RESM_ALLOWED_ORIGINS=https://tauri.localhost,http://tauri.localhost
RESM_STATIC_DIR=/srv/resm/web
