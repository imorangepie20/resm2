{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RESM",
  "version": "0.1.0",
  "identifier": "team.approid.resm",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --dir ../web dev --mode tauri-dev",
    "beforeBuildCommand": "pnpm --dir ../web build --mode tauri-prod"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RESM",
        "width": 1664,
        "height": 1040,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: https://ipc.localhost https://resm2.approid.team",
        "script-src": "'self' https://t1.kakaocdn.net",
        "style-src": "'self' 'unsafe-inline'",
        "frame-src": "https://postcode.map.kakao.com",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
