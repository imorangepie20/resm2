{
  "name": "resm",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:web": "pnpm --dir web dev",
    "build:web": "pnpm --dir web build",
    "test:web": "pnpm --dir web test",
    "dev:server": "cargo run -p resm-server",
    "test:e2e": "pnpm --dir web test:e2e",
    "app:dev": "pnpm --dir app tauri dev",
    "app:build:win": "pnpm --dir app tauri build",
    "app:android:dev": "pnpm --dir app tauri android dev --host 127.0.0.1",
    "app:build:android": "pnpm --dir app tauri android build --apk"
  }
}
